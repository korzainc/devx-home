# Copy to .env.local for local development. Never commit .env.local.

# Neon Postgres. Both are written by `vercel env pull`. The pooled URL serves the app; the
# unpooled one is for schema changes, which PgBouncer's transaction pooling does not suit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The Korza DevX GitHub App, github.com/apps/korza-devx. The client secret is shown once when
# generated and cannot be read back, so a lost one has to be regenerated.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Signs session cookies and encrypts the GitHub tokens held in the account table. Changing it
# invalidates every session and orphans every stored token, so everyone has to sign in again.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The origin the app is served from. Better Auth builds the OAuth callback from this and does not
# infer it from VERCEL_URL, so every deployment needs it set to match a callback URL registered
# on the App. Use http://localhost:3000 locally.
BETTER_AUTH_URL=
