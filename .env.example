# Copy to .env.local for local development. Never commit .env.local.

# Neon Postgres. Both are written by `vercel env pull`. The pooled URL serves the app; the
# unpooled one is for schema changes, which PgBouncer's transaction pooling does not suit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The Korza DevX GitHub App, github.com/apps/korza-devx. The client secret is shown once when
# generated and cannot be read back, so a lost one has to be regenerated.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Signs session cookies and encrypts the GitHub tokens held in the account table. Changing it
# invalidates every session and orphans every stored token, so everyone has to sign in again.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The origin the app is served from. Better Auth builds the OAuth callback from this and does not
# infer it from VERCEL_URL, so every deployment needs it set to match a callback URL registered
# on the App. Use http://localhost:3000 locally.
BETTER_AUTH_URL=

# Set to `true` for bypassing auth (github) locally for development
LOCAL_BYPASS_AUTH=

# Gap-analysis LLM pass. Runs only on the gated /api/analyze route, never the anonymous
# /ci-coverage page. Use a dedicated Anthropic key with its own monthly spend limit set in the
# Anthropic Console. With no key set, the pass stays off and the report is unchanged.
ANTHROPIC_API_KEY=
# Kill switch. The pass runs only when this is exactly "true".
GAP_LLM_ENABLED=
# Daily budget in dollars. Once today's tracked spend reaches it, the pass stops until the next
# UTC day. This is a soft cap: concurrent requests can overshoot it, so the provider-side monthly
# limit on the key above is the real ceiling.
GAP_LLM_DAILY_USD_CAP=5
# One of low, medium, high, xhigh, max. An invalid value falls back to "low". xhigh and max often
# run past the 30s request timeout, which falls back to the deterministic report.
GAP_LLM_EFFORT=low

# Local development only: set to "openrouter" to run the pass through OpenRouter instead of
# Anthropic. Leave unset in every deployed environment.
GAP_LLM_PROVIDER=
OPENROUTER_API_KEY=
# A model slug from openrouter.ai/models. There is no default, since which models are free or
# worth using changes over time.
GAP_LLM_OPENROUTER_MODEL=
