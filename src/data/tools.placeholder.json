[
  {
    "id": "eslint",
    "name": "ESLint",
    "summary": "Static analysis for JavaScript and TypeScript, driven by a flat config the repo owns.",
    "category": "Linting",
    "capabilities": ["lint"],
    "stacks": ["javascript", "typescript"],
    "docsUrl": "https://eslint.org/docs/latest/",
    "detect": {
      "configFiles": [
        "eslint.config.js",
        "eslint.config.mjs",
        "eslint.config.cjs",
        "eslint.config.ts",
        ".eslintrc.json",
        ".eslintrc.js",
        ".eslintrc.cjs",
        ".eslintrc.yml"
      ],
      "manifestDeps": ["eslint"],
      "commands": ["eslint", "next lint"],
      "ciUses": ["reviewdog/action-eslint"]
    }
  },
  {
    "id": "prettier",
    "name": "Prettier",
    "summary": "Opinionated formatter. Running it in CI removes formatting from code review entirely.",
    "category": "Formatting",
    "capabilities": ["format"],
    "stacks": ["javascript", "typescript"],
    "docsUrl": "https://prettier.io/docs/en/",
    "detect": {
      "configFiles": [
        ".prettierrc",
        ".prettierrc.json",
        ".prettierrc.js",
        ".prettierrc.yml",
        "prettier.config.js",
        "prettier.config.mjs"
      ],
      "manifestDeps": ["prettier"],
      "commands": ["prettier"],
      "ciUses": ["creyD/prettier_action"]
    }
  },
  {
    "id": "biome",
    "name": "Biome",
    "summary": "Linter and formatter in one binary. Detected because a repo that uses it needs neither ESLint nor Prettier.",
    "category": "Linting",
    "capabilities": ["lint", "format"],
    "stacks": ["javascript", "typescript"],
    "docsUrl": "https://biomejs.dev/guides/getting-started/",
    "detect": {
      "configFiles": ["biome.json", "biome.jsonc"],
      "manifestDeps": ["@biomejs/biome"],
      "commands": ["biome"]
    }
  },
  {
    "id": "typescript",
    "name": "TypeScript",
    "summary": "Type checking as a build gate. Catches the class of bug tests rarely reach.",
    "category": "Types",
    "capabilities": ["typecheck"],
    "stacks": ["javascript", "typescript"],
    "docsUrl": "https://www.typescriptlang.org/docs/",
    "detect": {
      "configFiles": ["tsconfig.json"],
      "manifestDeps": ["typescript"],
      "commands": ["tsc"]
    }
  },
  {
    "id": "trivy",
    "name": "Trivy",
    "summary": "Scans lockfiles, images and IaC for known vulnerabilities. Skips devDependencies unless told otherwise.",
    "category": "Security",
    "capabilities": ["sca", "iac-scanning", "container-scanning"],
    "stacks": ["any"],
    "docsUrl": "https://trivy.dev/latest/docs/",
    "detect": {
      "configFiles": ["trivy.yaml", ".trivyignore"],
      "commands": ["trivy"],
      "ciUses": ["aquasecurity/trivy-action"]
    }
  },
  {
    "id": "kingfisher",
    "name": "Kingfisher",
    "summary": "Secret scanning that validates findings against the issuing API, so a live credential is distinguishable from a lookalike.",
    "category": "Security",
    "capabilities": ["secret-scanning"],
    "stacks": ["any"],
    "docsUrl": "https://github.com/mongodb/kingfisher",
    "detect": {
      "commands": ["kingfisher"],
      "ciUses": ["mongodb/kingfisher-action"]
    }
  },
  {
    "id": "gitleaks",
    "name": "Gitleaks",
    "summary": "The secret scanner most repos already reach for. Detected so an existing setup does not read as a gap.",
    "category": "Security",
    "capabilities": ["secret-scanning"],
    "stacks": ["any"],
    "docsUrl": "https://github.com/gitleaks/gitleaks",
    "detect": {
      "configFiles": [".gitleaks.toml", "gitleaks.toml", ".gitleaksignore"],
      "commands": ["gitleaks"],
      "ciUses": ["gitleaks/gitleaks-action"]
    }
  },
  {
    "id": "semgrep",
    "name": "Semgrep",
    "summary": "Pattern-based SAST with rules that read like the code they match.",
    "category": "Security",
    "capabilities": ["sast"],
    "stacks": ["any"],
    "docsUrl": "https://semgrep.dev/docs/",
    "detect": {
      "configFiles": [".semgrep.yml", ".semgrepignore"],
      "commands": ["semgrep"],
      "ciUses": ["semgrep/semgrep-action", "returntocorp/semgrep-action"]
    }
  },
  {
    "id": "codeql",
    "name": "CodeQL",
    "summary": "GitHub's own SAST. Detected because a repo running it already has the capability covered.",
    "category": "Security",
    "capabilities": ["sast"],
    "stacks": ["any"],
    "docsUrl": "https://codeql.github.com/docs/",
    "detect": {
      "configFiles": [".github/codeql-config.yml"],
      "ciUses": ["github/codeql-action"]
    }
  },
  {
    "id": "actionlint",
    "name": "actionlint",
    "summary": "Lints GitHub Actions workflows, including the inline shell, before a push proves it wrong.",
    "category": "CI Meta",
    "capabilities": ["workflow-lint"],
    "stacks": ["any"],
    "docsUrl": "https://github.com/rhysd/actionlint",
    "detect": {
      "configFiles": [".github/actionlint.yaml", ".github/actionlint.yml"],
      "commands": ["actionlint"],
      "ciUses": ["raven-actions/actionlint", "reviewdog/action-actionlint"]
    }
  },
  {
