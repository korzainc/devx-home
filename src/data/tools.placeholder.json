  },
  {
    "id": "playwright",
    "name": "Playwright",
    "summary": "Browser-level end-to-end tests, run against a real build rather than a dev server.",
    "category": "Testing",
    "capabilities": ["e2e-tests"],
    "stacks": ["javascript", "typescript"],
    "docsUrl": "https://playwright.dev/docs/intro",
