      "commands": ["vitest"]
    }
  },
  {
    "id": "jest",
    "name": "Jest",
    "summary": "The incumbent JavaScript test runner. Detected so an existing suite counts as coverage of unit testing.",
    "category": "Testing",
    "capabilities": ["unit-tests", "coverage"],
