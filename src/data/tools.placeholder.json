        "renovate.json",
        "renovate.json5",
        ".renovaterc",
        ".renovaterc.json",
        ".github/renovate.json"
      ],
      "ciUses": ["renovatebot/github-action"]
    }
  },
  {
    "id": "dependabot",
    "name": "Dependabot",
    "summary": "GitHub's built-in update bot. One config file, no service to run, so it is the common alternative to Renovate.",
    "category": "Dependencies",
    "capabilities": ["dependency-updates"],
    "stacks": ["any"],
    "docsUrl": "https://docs.github.com/code-security/dependabot",
    "detect": {
      "configFiles": [".github/dependabot.yml", ".github/dependabot.yaml"]
    }
  },
  {
    "id": "codecov",
    "name": "Codecov",
    "summary": "Coverage reporting with per-PR deltas. Useful as a signal, hazardous as a hard gate.",
    "category": "Testing",
    "capabilities": ["coverage"],
    "stacks": ["any"],
    "docsUrl": "https://docs.codecov.com/docs",
    "detect": {
      "configFiles": ["codecov.yml", ".codecov.yml"],
      "commands": ["codecov"],
      "ciUses": ["codecov/codecov-action"]
    }
  },
  {
